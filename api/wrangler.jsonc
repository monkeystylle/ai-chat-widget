{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chat-widget-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 8,
        "period": 60,
      },
    },
  ],
}
